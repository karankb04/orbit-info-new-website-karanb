{
  // Cloudflare Workers, static assets only: no Worker script runs, so requests
  // are free and uncapped. `npm run build` writes the site to out/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    // /about serves out/about.html; unknown paths get out/404.html with a 404.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
